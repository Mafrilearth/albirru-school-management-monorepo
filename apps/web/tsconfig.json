{
  "extends": "../../packages/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@payload-config": ["./src/payload.config.ts"],
      "@albirru/database": ["../../packages/database/src/index.ts"],
      "@albirru/database/*": ["../../packages/database/src/*"],
      "@albirru/design-system": ["../../packages/design-system/src/index.ts"],
      "@albirru/design-system/*": ["../../packages/design-system/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
