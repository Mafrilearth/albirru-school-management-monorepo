# ==============================================================================
# Al-Birru School Information System (albirru-sis)
# Standardized Environment Variable Specification Template
# ==============================================================================

# Node Runtime Environment
NODE_ENV=development

# Canonical Public Site URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Primary Relational Database (Neon Serverless PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:password@ep-placeholder.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication & User Management (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Cache & Ingress Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://placeholder.upstash.io
UPSTASH_REDIS_REST_TOKEN=placeholder_token

# Bot Deterrence & CAPTCHA Alternative (Cloudflare Turnstile)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAABBBBBBCCCCCC
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAABBBBBBCCCCCCDDDDDD

# Transactional Email Dispatch (Resend)
RESEND_API_KEY=re_placeholder_key

# Exception & Crash Monitoring (Sentry)
NEXT_PUBLIC_SENTRY_DSN=https://placeholder@o0.ingest.sentry.io/0

# Product Analytics & Feature Flags (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=phc_placeholder_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Model Context Protocol (MCP) Integration Tokens
NOTION_TOKEN=ntn_placeholder_token
CONTEXT7_API_KEY=ctx7sk_placeholder_key
GITHUB_TOKEN=ghp_placeholder_token
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_placeholder_token
CLOUDFLARE_API_TOKEN=cf_placeholder_token

